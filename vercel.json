{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/nocatee-house-washing",
      "destination": "https://hydrosealpavers.com/house-washing",
      "permanent": true
    },
    {
      "source": "/nocatee-roof-washing",
      "destination": "https://hydrosealpavers.com/roof-washing",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    }
  ]
}